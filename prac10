script.js:-
const fetchContainer = document.getElementById('fetchTableContainer');
const jqueryContainer = document.getElementById('jqueryTableContainer');
const departmentFilter = document.getElementById('departmentFilter');

// Function to create table dynamically
function createTable(data, container) {
    container.innerHTML = ''; // Clear previous content

    const table = document.createElement('table');
    const thead = document.createElement('thead');
    const headerRow = document.createElement('tr');
    ['ID', 'Name', 'Department', 'Salary'].forEach(text => {
        const th = document.createElement('th');
        th.textContent = text;
        headerRow.appendChild(th);
    });
    thead.appendChild(headerRow);
    table.appendChild(thead);

    const tbody = document.createElement('tbody');
    data.forEach(emp => {
        const row = document.createElement('tr');
        if(emp.salary > 50000) row.classList.add('highlight'); // Highlight high salary
        Object.values(emp).forEach(val => {
            const td = document.createElement('td');
            td.textContent = val;
            row.appendChild(td);
        });
        tbody.appendChild(row);
    });
    table.appendChild(tbody);

    container.appendChild(table);
    console.table(data);
}

// Function to populate department dropdown dynamically
function populateDepartments(data) {
    const uniqueDepartments = [...new Set(data.map(emp => emp.department))];
    uniqueDepartments.forEach(dep => {
        const option = document.createElement('option');
        option.value = dep;
        option.textContent = dep;
        departmentFilter.appendChild(option);
    });
}

// Filter function
function filterByDepartment(data, department) {
    if(department === 'All') return data;
    return data.filter(emp => emp.department === department);
}

// Fetch API
fetch('employees.json')
    .then(response => response.json())
    .then(data => {
        populateDepartments(data);
        createTable(data, fetchContainer);

        // Add filter listener
        departmentFilter.addEventListener('change', () => {
            const filtered = filterByDepartment(data, departmentFilter.value);
            createTable(filtered, fetchContainer);
        });
    })
    .catch(err => console.error('Fetch error:', err));

// jQuery $.getJSON
$.getJSON('employees.json', function(data) {
    createTable(data, jqueryContainer);

    // Add filter listener
    $('#departmentFilter').on('change', function() {
        const filtered = filterByDepartment(data, this.value);
        createTable(filtered, jqueryContainer);
    });
});

</head>
<body>

<h1>Employee Directory Manager</h1>

<h2>Filter by Department</h2>
<select id="departmentFilter">
    <option value="All">All Departments</option>
</select>

<h2>Employees Loaded via Fetch API</h2>
<div id="fetchTableContainer"></div>

<h2>Employees Loaded via jQuery $.getJSON()</h2>
<div id="jqueryTableContainer"></div>

<script src="script.js"></script>
</body>

// ui.js — handles dynamic UI, responsiveness, and event delegation
import { logEvent } from './helper.js';

// Change background color based on screen width
export function handleViewportChange() {
  if (window.innerWidth < 600) {
    document.body.style.background = '#f0f8ff';
  } else {
    document.body.style.background = 'white';
  }
}

// Event delegation for sessions
export function addDynamicSessions() {
  const sessionsDiv = document.getElementById('sessions');
  sessionsDiv.addEventListener('click', (e) => {
    if (e.target.classList.contains('session')) {
      alert("You selected: " + e.target.textContent);
      logEvent(`Session clicked: ${e.target.textContent}`);
    }
  });
}

// Add new session dynamically
export function setupAddSessionButton() {
  const btn = document.getElementById('addSessionBtn');
  const sessionsDiv = document.getElementById('sessions');

  btn.addEventListener('click', () => {
    const newTime = prompt("Enter new session time (e.g., 12:00):");
    const newTopic = prompt("Enter session topic:");

    if (newTime && newTopic) {
      const div = document.createElement('div');
      div.classList.add('session');
      div.dataset.time = newTime;
      div.textContent = `${newTopic} - ${newTime}`;
      sessionsDiv.appendChild(div);
      logEvent(`Added new session: ${newTopic} at ${newTime}`);
    }
  });
}
